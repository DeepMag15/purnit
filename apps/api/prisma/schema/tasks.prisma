model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// Documents module review (2026-08-26) — the Education submission link.
  ///
  /// A student's submission IS a task: assigned to them, sitting in their own
  /// restricted submissions project, carrying the uploaded work as evidence
  /// (`Document.taskId`) and reviewed through the ordinary
  /// `task.submitForReview` / `task.review` pair. This column is what ties
  /// that task back to the Assignment it answers, so a student sees "submitted"
  /// against the right row and a teacher's queue names the work.
  ///
  /// Nullable, and null for every task outside Education — nothing else in the
  /// platform answers an assignment.
  assignmentId String?    @map("assignment_id") @db.Uuid
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  projectId   String    @map("project_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id])
  title       String
  description String?
  /// todo | in_progress | in_review | done — enforced server-side as of the
  /// Projects ecosystem review. Previously free text, so `in_review` was
  /// accepted and understood by nothing.
  ///
  /// `in_review` is a one-way door: `task.updateStatus` refuses to move a
  /// task out of it, so once work is submitted only a reviewer decides. Review
  /// itself stays OPTIONAL — a task may still go straight to `done`, which is
  /// what keeps routine work usable.
  status      String    @default("todo")
  /// Who submitted this for review, and when. Null until it is submitted, and
  /// deliberately kept after review so "who sent this" survives the decision.
  submittedById String? @map("submitted_by_id") @db.Uuid
  submittedAt   DateTime? @map("submitted_at")
  /// Who decided. Never the same person as `submittedById` — enforced in
  /// `task.review`, not merely expected.
  reviewedById  String? @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at")
  reviewNote    String?   @map("review_note")
  assigneeId  String?   @map("assignee_id") @db.Uuid
  priority    String    @default("medium")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  documents Document[]

  @@index([tenantId, projectId])
  @@index([tenantId, assigneeId])
  @@map("tasks")
}
