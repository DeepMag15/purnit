model Project {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  description  String?
  status       String    @default("active")
  ownerId      String?   @map("owner_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  /// Contextual Reporting (2026-08-25) — the document access boundary.
  ///
  /// `project:read:tenant` used to return every project, and every domain
  /// entity is backed by a Project, so patient charts, student submissions and
  /// registrar student-files were all readable by anyone holding that grant —
  /// and Documents live on those projects, so file access inherited the same
  /// reach. A restricted project is reachable only by its owner, its members,
  /// or a caller holding `accessPermission`. See `projectsWhere`.
  ///
  /// Default false, so ordinary projects, course materials, client files and
  /// inventory files behave exactly as they always have.
  restricted   Boolean   @default(false)
  /// The role-level way into a restricted project, for cases where per-row
  /// membership is the wrong model: a Nurse must reach ANY patient chart
  /// without being named on each one, so charts carry `patient:update` here.
  /// Null means membership or ownership only — which is what a student's
  /// private submissions project wants.
  accessPermission String? @map("access_permission")
  /// Module review, Projects (2026-08-26) — is this a project a person made, or
  /// plumbing behind a domain entity?
  ///
  /// Four of five domains have no Projects module at all: a Project backs each
  /// Patient / Course / Client / InventoryItem / Enrollment / Student so that
  /// Documents, Comments and Tasks attach through machinery that already
  /// resolves scope. That is a good design and stays. What was wrong is that
  /// `projects.list` returned those rows as user-facing Projects, so a Nurse
  /// creating a Care Task picked from a dropdown reading "Chart: J. Chen" —
  /// internal plumbing names, never meant to be seen (verified live, all four
  /// domains).
  ///
  /// "project" = a real one. Anything else names the entity behind it
  /// ("chart", "materials", "clientFiles", "itemFiles", "submissions",
  /// "studentFile") and is excluded from every project-shaped surface.
  ///
  /// ⚠️ Deliberately NOT filtered inside `projectsWhere`: that function also
  /// governs document access, and filtering there would cut every domain off
  /// from its own files. The exclusion belongs to the project-shaped sources
  /// only — `projects.list`, `project.detail` and the project metrics.
  kind         String    @default("project")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tasks     Task[]
  members   ProjectMember[]
  documents Document[]

  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@index([tenantId, departmentId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, userId])
  @@index([tenantId])
  @@map("project_members")
}
