# Copy to .env and fill in. Never commit the real .env file.

# --- Supabase (needed from Stage 1 onward) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Prisma) ---
# Runtime app connection: NO BYPASSRLS, used by the NestJS app at request time.
DATABASE_URL=
# Migration connection: elevated role with BYPASSRLS, used only by `prisma migrate`.
DIRECT_URL=

# --- API ---
PORT=4000
JWT_ISSUER=

# --- Email (Resend) — needed for the invite-email onboarding flow ---
# Sign up at resend.com, verify a sending domain, generate an API key.
RESEND_API_KEY=
# Must be an address on a domain verified in the Resend dashboard.
EMAIL_FROM=
# Base URL of the deployed frontend — used to build the login link in
# invite emails. http://localhost:3000 in local dev.
APP_BASE_URL=http://localhost:3000

# --- Meetings (Jitsi, self-hosted via docker-jitsi-meet — see infra/jitsi/README.md) ---
# Temporary, free-for-now vendor choice — see CONTEXT.md. Must exactly match
# JWT_APP_ID/JWT_APP_SECRET in infra/jitsi/docker-jitsi-meet/.env — generated
# once, copied by hand to both places; no automated sync exists.
JWT_APP_ID=
JWT_APP_SECRET=

# --- AI Assistant (completion: Phase A; embeddings: Phase B; OpenAI adapter + per-tenant override: Phase F) ---
# Provider selection — "anthropic" (default), "gemini", or "openai" for
# completion (a tenant can also override this individually — see Settings),
# "gemini" (default, only option today) for embeddings. Only the selected
# provider's API key below is actually required.
AI_COMPLETION_PROVIDER=anthropic
AI_COMPLETION_MODEL=
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Enterprise SSO (self-hosted Keycloak broker — see infra/keycloak/README.md) ---
# Supabase's own native Enterprise SSO isn't available on this project's
# Supabase tier, so SSO is brokered through a self-hosted Keycloak realm
# instead (Apache 2.0, free, self-hosted — see CONTEXT.md). Our backend
# speaks OIDC only; Keycloak itself absorbs any SAML complexity as its own
# upstream Identity Provider config, per tenant.
# 1. `docker compose up -d` from infra/keycloak/ and import the realm — see
#    that directory's own README.md for the full one-time setup.
# 2. KEYCLOAK_ISSUER_URL is the realm's own issuer (e.g.
#    http://localhost:8081/realms/purnit for the local dev compose setup).
# 3. KEYCLOAK_CLIENT_ID/SECRET are this app's own single OIDC client inside
#    that realm (not per-tenant — each tenant's own upstream IdP secrets
#    live inside Keycloak's own database, never here).
# 4. SSO_STATE_SECRET signs the stateless OIDC `state` token
#    (SsoStateService) — any long random string, generated once.
# 5. API_BASE_URL is this API's own public address (not APP_BASE_URL below,
#    which is the frontend's) — Keycloak redirects back to
#    ${API_BASE_URL}/auth/sso/callback. Defaults to localhost:$PORT if unset.
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/purnit
KEYCLOAK_CLIENT_ID=purnit-api
KEYCLOAK_CLIENT_SECRET=
SSO_STATE_SECRET=
API_BASE_URL=http://localhost:4000

# --- Billing (Stripe) ---
# The app runs end-to-end with NONE of these set: StripeService.isConfigured()
# is false, the signup wizard provisions the workspace with
# subscriptionStatus "pending_payment" instead of redirecting to Checkout,
# and every price still renders correctly from the PlanPrice rows in our own
# database (Stripe is the charge authority, our DB is the display authority).
# Filling these in activates real checkout with no code change.
#
# Setup, once a Stripe account exists (stay in Test mode until go-live):
# 1. Create one Product per paid tier (Starter, Professional).
# 2. Under each Product create TWO recurring Prices — one monthly, one yearly
#    — each billed *per unit* (seats are the subscription quantity). Yearly
#    unit price already includes the 2-months-free discount; it is not applied
#    as a separate coupon.
# 3. Copy each id below, then re-run `pnpm --filter @purnit/api run prisma:seed`
#    so the PlanPrice rows pick them up.
# 4. Run `stripe listen --forward-to localhost:4000/api/webhooks/stripe`
#    (Stripe CLI) and copy the webhook signing secret it prints.
# Enterprise is deliberately absent — it is "contact us", not self-serve.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_STARTER=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRODUCT_PROFESSIONAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=

# --- Environment & origins (production readiness) ---
# Which deployment this process is. Drives Sentry's environment tag and the
# CORS allowlist below. One of: development | staging | production.
APP_ENV=development
# Comma-separated exact origins allowed to call this API. Empty in local dev
# means "allow any origin" (today's `app.enableCors()` behaviour, kept only
# for localhost); staging and production MUST set this explicitly.
CORS_ALLOWED_ORIGINS=

# --- Observability (Sentry) ---
# Unset = Sentry is inert, no events sent. Safe to leave empty in local dev.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Same values as SUPABASE_URL/SUPABASE_ANON_KEY above, duplicated under
# NEXT_PUBLIC_ so Next.js exposes them to browser code. The anon/publishable
# key is designed to be public (rate-limited + RLS-protected server-side) —
# this is not a secret leak, unlike the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# localhost:8000 (plain HTTP) works directly for local dev — verified live
# that this default docker-jitsi-meet setup does not force an HTTPS redirect,
# and localhost is always a browser-trusted secure context either way. Use
# localhost:8443 only if you need HTTPS for another reason (self-signed cert,
# each browser profile must click through the warning once).
NEXT_PUBLIC_JITSI_DOMAIN=localhost:8000
# @jitsi/react-sdk's own external_api.js loader hardcodes "https://" with no
# override — must match whatever NEXT_PUBLIC_JITSI_DOMAIN actually serves.
# "http" for this local dev setup; "https" for a real hosted vendor later.
NEXT_PUBLIC_JITSI_PROTOCOL=http
