# Copy to .env and fill in. Never commit the real .env file.

# --- Supabase (needed from Stage 1 onward) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Prisma) ---
# Runtime app connection: NO BYPASSRLS, used by the NestJS app at request time.
DATABASE_URL=
# Migration connection: elevated role with BYPASSRLS, used only by `prisma migrate`.
DIRECT_URL=

# --- API ---
PORT=4000
JWT_ISSUER=

# --- Email (Resend) — needed for the invite-email onboarding flow ---
# Sign up at resend.com, verify a sending domain, generate an API key.
RESEND_API_KEY=
# Must be an address on a domain verified in the Resend dashboard.
EMAIL_FROM=
# Base URL of the deployed frontend — used to build the login link in
# invite emails. http://localhost:3000 in local dev.
APP_BASE_URL=http://localhost:3000

# --- Meetings (Jitsi, self-hosted via docker-jitsi-meet — see infra/jitsi/README.md) ---
# Temporary, free-for-now vendor choice — see CONTEXT.md. Must exactly match
# JWT_APP_ID/JWT_APP_SECRET in infra/jitsi/docker-jitsi-meet/.env — generated
# once, copied by hand to both places; no automated sync exists.
JWT_APP_ID=
JWT_APP_SECRET=

# --- AI Assistant (completion: Phase A; embeddings: Phase B) ---
# Provider selection — "anthropic" (default) or "gemini" for completion,
# "gemini" (default, only option today) for embeddings. Only the selected
# provider's API key below is actually required.
AI_COMPLETION_PROVIDER=anthropic
AI_COMPLETION_MODEL=
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Same values as SUPABASE_URL/SUPABASE_ANON_KEY above, duplicated under
# NEXT_PUBLIC_ so Next.js exposes them to browser code. The anon/publishable
# key is designed to be public (rate-limited + RLS-protected server-side) —
# this is not a secret leak, unlike the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# localhost:8000 (plain HTTP) works directly for local dev — verified live
# that this default docker-jitsi-meet setup does not force an HTTPS redirect,
# and localhost is always a browser-trusted secure context either way. Use
# localhost:8443 only if you need HTTPS for another reason (self-signed cert,
# each browser profile must click through the warning once).
NEXT_PUBLIC_JITSI_DOMAIN=localhost:8000
# @jitsi/react-sdk's own external_api.js loader hardcodes "https://" with no
# override — must match whatever NEXT_PUBLIC_JITSI_DOMAIN actually serves.
# "http" for this local dev setup; "https" for a real hosted vendor later.
NEXT_PUBLIC_JITSI_PROTOCOL=http
