# The delta this project requires on top of docker-jitsi-meet's own
# env.example — NOT a full copy of that file (it's a large third-party
# config surface; see infra/jitsi/README.md for the full setup sequence).
#
# These exact keys also need to exist in infra/jitsi/docker-jitsi-meet/.env
# (already configured there by setup) AND in this repo's own root .env
# (JWT_APP_ID/JWT_APP_SECRET only — apps/api's JitsiService signs tokens
# with them). All three copies must match exactly, by hand — no automated
# sync exists.

CONFIG=./.jitsi-meet-cfg
ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt
JWT_APP_ID=antigravity-dev
JWT_APP_SECRET=<generate with: openssl rand -hex 32>
JWT_ACCEPTED_ISSUERS=antigravity-dev
JWT_ACCEPTED_AUDIENCES=antigravity-dev
